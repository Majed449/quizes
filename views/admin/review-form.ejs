<%- include('partials/layout-top', { activePage: 'reviews' }) %>

<div class="page-actions-bar">
  <h2 class="page-bar-title"><%= mode === 'create' ? '➕ مراجعة جديدة' : '✏️ تعديل المراجعة' %></h2>
  <a href="/admin/reviews" class="btn-sm">← العودة</a>
</div>

<form id="reviewForm" action="<%= mode === 'create' ? '/admin/reviews' : '/admin/reviews/' + review.id %>" method="POST">

  <!-- Review Meta -->
  <div class="section-card">
    <div class="section-card-header"><h3>📋 معلومات المراجعة</h3></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">عنوان المراجعة *</label>
        <input type="text" name="title" class="form-input" required
               value="<%= review ? review.title : '' %>" placeholder="مثال: مراجعة الفيزياء الشاملة">
      </div>
      <div class="form-group">
        <label class="form-label">المادة الدراسية *</label>
        <input type="text" name="subject" class="form-input" required
               value="<%= review ? review.subject : '' %>" placeholder="مثال: الفيزياء">
      </div>
      <div class="form-group">
        <label class="form-label">الوصف</label>
        <input type="text" name="description" class="form-input"
               value="<%= review ? review.description : '' %>" placeholder="وصف مختصر">
      </div>
      <div class="form-group">
        <label class="form-label">الأيقونة</label>
        <input type="text" name="icon" class="form-input icon-input"
               value="<%= review ? review.icon : '📚' %>" maxlength="4">
      </div>
      <div class="form-group">
        <label class="form-label">اللون</label>
        <div class="color-input-wrap">
          <input type="color" name="color" id="colorPicker" class="color-picker"
                 value="<%= review ? review.color : '#00d4aa' %>">
          <input type="text" id="colorText" class="form-input" style="flex:1"
                 value="<%= review ? review.color : '#00d4aa' %>" placeholder="#00d4aa">
        </div>
      </div>
    </div>
  </div>

  <!-- Sections Builder -->
  <div class="section-card">
    <div class="section-card-header">
      <h3>📂 الأقسام (<span id="sectionCount">0</span>)</h3>
      <button type="button" class="btn-sm btn-green" onclick="addSection()">➕ إضافة قسم</button>
    </div>

    <div id="sectionsBuilder" class="sections-builder">
      <div class="questions-empty" id="emptyMsg">
        <span>📂</span> لم تضف أي أقسام بعد — اضغط على "إضافة قسم" للبدء
      </div>
    </div>
  </div>

  <input type="hidden" name="sections" id="sectionsInput">

  <div class="form-actions">
    <a href="/admin/reviews" class="btn btn-outline">إلغاء</a>
    <button type="submit" class="btn btn-primary" onclick="return prepareSubmit()">
      <%= mode === 'create' ? '✅ إنشاء المراجعة' : '💾 حفظ التعديلات' %>
    </button>
  </div>
</form>

<script>
const INITIAL_REVIEW = <%- JSON.stringify(review) %>;
</script>
<%- include('partials/layout-bottom', { pageScript: 'admin-review-form' }) %>
