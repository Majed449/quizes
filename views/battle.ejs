<%- include('partials/header', { pageStyle: 'battle' }) %>

<main class="battle-main">
  <div class="battle-wrapper">
    
    <!-- ── VIEW MODE: CREATE ROOM ────────────────────────────────────── -->
    <% if (viewMode === 'create') { %>
      <div class="battle-card join-card">
        <div class="battle-card-header">
          <span class="battle-icon"><i class="fa-solid fa-gamepad"></i></span>
          <h2>إنشاء تحدي جديد</h2>
          <p>أدخل اسمك المستعار لإنشاء غرفة التحدي لاختبار: <strong><%= quizTitle %></strong></p>
        </div>
        
        <form action="/battle/create" method="POST" class="battle-form">
          <input type="hidden" name="quizId" value="<%= quizId %>">
          <div class="form-group">
            <label for="playerName"><i class="fa-solid fa-user"></i> اسمك المستعار:</label>
            <input type="text" id="playerName" name="playerName" placeholder="أدخل اسمك هنا..." required autocomplete="off">
          </div>
          
          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label for="questionCount"><i class="fa-solid fa-list-ol"></i> عدد أسئلة التحدي:</label>
            <div class="custom-select-container" data-target="questionCount" id="questionCountSelect">
              <div class="custom-select-trigger" tabindex="0" role="combobox" aria-expanded="false" style="padding: 0.75rem 1.1rem;">
                <span class="custom-select-value">كل الأسئلة (<%= totalQuestions %>)</span>
                <i class="fa-solid fa-chevron-down"></i>
              </div>
              <div class="custom-select-options" role="listbox">
                <div class="custom-select-option selected" data-value="all" role="option">كل الأسئلة (<%= totalQuestions %>)</div>
                <% [5, 10, 20, 50].forEach(num => { %>
                  <% if (totalQuestions > num) { %>
                    <div class="custom-select-option" data-value="<%= num %>" role="option"><%= num %> سؤال</div>
                  <% } %>
                <% }) %>
              </div>
            </div>
            <input type="hidden" id="questionCount" name="questionCount" value="all">
          </div>
          
          <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-plus"></i> أنشئ غرفة التحدي</button>
        </form>
        
        <div class="join-card-footer">
          <a href="/quiz" class="btn btn-outline btn-block"><i class="fa-solid fa-arrow-right"></i> العودة لقائمة الاختبارات</a>
        </div>
      </div>
    <% } %>

    <!-- ── VIEW MODE: JOIN ROOM ──────────────────────────────────────── -->
    <% if (viewMode === 'join') { %>
      <div class="battle-card join-card">
        <div class="battle-card-header">
          <span class="battle-icon"><i class="fa-solid fa-gamepad"></i></span>
          <h2>انضمام لتحدي مباشر</h2>
          <p>أدخل كود الغرفة المكون من 6 أرقام للعب ضد زميلك في نفس الوقت!</p>
        </div>
        
        <% if (error) { %>
          <div class="battle-error-box">
            <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
          </div>
        <% } %>
        
        <form action="/battle/join" method="POST" class="battle-form">
          <div class="form-group">
            <label for="playerName"><i class="fa-solid fa-user"></i> اسمك المستعار:</label>
            <input type="text" id="playerName" name="playerName" placeholder="أدخل اسمك هنا..." required autocomplete="off">
          </div>
          <div class="form-group">
            <label for="roomCode"><i class="fa-solid fa-key"></i> كود الغرفة (6 أرقام):</label>
            <input type="text" id="roomCode" name="roomCode" value="<%= locals.roomCode || '' %>" placeholder="مثال: 123456" required autocomplete="off" maxlength="6" pattern="\d{6}" style="text-align: center; letter-spacing: 0.2em; font-size: 1.25rem;">
          </div>
          <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-arrow-right-to-bracket"></i> دخول الغرفة</button>
        </form>
        
        <div class="join-card-footer">
          <a href="/quiz" class="btn btn-outline btn-block"><i class="fa-solid fa-arrow-right"></i> العودة لقائمة الاختبارات</a>
        </div>
      </div>
    <% } %>

    <!-- ── VIEW MODE: LOBBY & ARENA ──────────────────────────────────── -->
    <% if (viewMode === 'lobby') { %>
      <!-- 1. LOBBY CONTAINER (Waiting for players) -->
      <div id="lobbyContainer" class="battle-card lobby-card" style="<%= (locals.roomStatus || 'waiting') === 'waiting' ? '' : 'display: none;' %>">
        <div class="battle-card-header">
          <span class="battle-icon waiting-spin"><i class="fa-solid fa-circle-notch"></i></span>
          <h2>بانتظار انضمام المنافس...</h2>
          <p>شارك كود التحدي مع زميلك لبدء المنافسة فوراً</p>
        </div>

        <div class="room-code-display" title="انقر لنسخ كود التحدي">
          <span class="code-label">كود الغرفة:</span>
          <span class="code-number" id="roomCodeVal"><%= roomCode %></span>
          <button class="code-copy-btn" onclick="copyRoomCode()"><i class="fa-regular fa-copy"></i></button>
        </div>

        <div class="battle-lobby-badge" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin: 1rem 0; padding: 0.5rem; background: rgba(var(--accent-rgb), 0.08); border: 1px solid rgba(var(--accent-rgb), 0.15); border-radius: 8px; font-weight: 700; color: var(--accent); font-size: 0.95rem;">
          <i class="fa-solid fa-list-ol"></i>
          <span>عدد أسئلة التحدي: <%= questionCount %></span>
        </div>

        <div class="players-lobby-list">
          <h3>اللاعبون المتصلون:</h3>
          <div class="player-lobby-row p1-row">
            <span class="player-avatar"><i class="fa-solid fa-user-astronaut"></i></span>
            <span class="player-name-lobby" id="lobbyP1Name"><%= playerName %> (أنت)</span>
            <span class="player-status-lobby ready">جاهز للعب</span>
          </div>
          <div class="player-lobby-row p2-row empty" id="lobbyP2Row">
            <span class="player-avatar"><i class="fa-solid fa-hourglass-start"></i></span>
            <span class="player-name-lobby" id="lobbyP2Name">بانتظار المنافس...</span>
            <span class="player-status-lobby waiting">ينتظر</span>
          </div>
        </div>
        
        <div style="margin-top: 1.5rem; text-align: center;">
          <a href="/quiz" class="btn btn-outline"><i class="fa-solid fa-arrow-right"></i> مغادرة الغرفة</a>
        </div>
      </div>

      <!-- 2. ARENA CONTAINER (Active Quiz Battle) -->
      <div id="arenaContainer" class="battle-card arena-card" style="<%= (locals.roomStatus || 'waiting') === 'playing' ? '' : 'display: none;' %>">
        <div class="arena-header">
          <h2 id="arenaQuizTitle"><%= quizTitle %></h2>
          <div class="arena-timer" id="arenaTimer"><i class="fa-solid fa-stopwatch"></i> <span id="timerVal">00:00</span></div>
        </div>

        <!-- Progress Bars Tracker -->
        <div class="battle-tracker">
          <!-- Player 1 (You) -->
          <div class="tracker-row client-tracker">
            <div class="tracker-info">
              <span class="tracker-name"><i class="fa-solid fa-user-astronaut"></i> <span id="p1Name"><%= playerName %></span> (أنت)</span>
              <span class="tracker-score"><span id="p1Score">0</span> إجابات صحيحة</span>
            </div>
            <div class="progress-bar-wrap">
              <div class="progress-bar-fill" id="p1ProgressBar" style="width: 0%;"></div>
            </div>
          </div>

          <!-- Player 2 (Opponent) -->
          <div class="tracker-row opponent-tracker">
            <div class="tracker-info">
              <span class="tracker-name"><i class="fa-solid fa-user-ninja"></i> <span id="p2Name">المنافس</span></span>
              <span class="tracker-score"><span id="p2Score">0</span> إجابات صحيحة</span>
            </div>
            <div class="progress-bar-wrap">
              <div class="progress-bar-fill" id="p2ProgressBar" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <hr class="arena-divider">

        <!-- Question View Box -->
        <div class="arena-question-box" id="arenaQuestionBox">
          <div class="question-meta">
            السؤال <span id="currentQuestionNum">1</span> من <span id="totalQuestionsNum">10</span>
          </div>
          
          <h3 class="question-text" id="arenaQuestionText">جاري تحميل السؤال...</h3>

          <div class="arena-options-grid" id="arenaOptionsGrid">
            <!-- Options injected dynamically -->
          </div>
        </div>

        <!-- Action Button (Next Question placeholder/controls if needed, but we snap automatically) -->
      </div>

      <!-- 3. RESULTS CONTAINER (Match Over Panel) -->
      <div id="resultsContainer" class="battle-card results-card" style="<%= (locals.roomStatus || 'waiting') === 'finished' ? '' : 'display: none;' %>">
        <div class="results-header" id="resultsHeader">
          <!-- Declares Win / Lose / Tie -->
        </div>

        <div class="score-card-table">
          <div class="score-card-row header-row">
            <div>الترتيب</div>
            <div>اللاعب</div>
            <div>النتيجة</div>
            <div>الوقت</div>
          </div>
          <div class="score-card-row" id="resultRowP1">
            <div class="rank-badge r1" id="rankP1">#1</div>
            <div class="res-player-name" id="resP1Name"><%= playerName %></div>
            <div class="res-player-score" id="resP1Score">0 / 0</div>
            <div class="res-player-time" id="resP1Time">00:00</div>
          </div>
          <div class="score-card-row" id="resultRowP2">
            <div class="rank-badge r2" id="rankP2">#2</div>
            <div class="res-player-name" id="resP2Name">المنافس</div>
            <div class="res-player-score" id="resP2Score">0 / 0</div>
            <div class="res-player-time" id="resP2Time">00:00</div>
          </div>
        </div>

        <div class="results-actions">
          <a href="/quiz" class="btn btn-primary"><i class="fa-solid fa-house"></i> العودة للرئيسية</a>
        </div>
      </div>
    <% } %>

  </div>

  <!-- Custom Battle Modal Overlay -->
  <div id="battleModal" class="battle-modal-overlay" style="display: none;">
    <div class="battle-modal-content">
      <div class="battle-modal-icon" id="battleModalIcon">
        <i class="fa-solid fa-circle-info"></i>
      </div>
      <h3 id="battleModalTitle">تنبيه</h3>
      <p id="battleModalMessage"></p>
      <button id="battleModalBtn" class="btn btn-primary btn-block" onclick="closeBattleModal()">موافق</button>
    </div>
  </div>
</main>

<script src="/socket.io/socket.io.js"></script>
<script>
  // Expose basic room parameters safely to battle.js
  const ROOM_CODE = "<%= locals.roomCode || '' %>";
  const PLAYER_NAME = "<%= locals.playerName || '' %>";
  const ROOM_STATUS = "<%= locals.roomStatus || 'waiting' %>";
</script>

<%- include('partials/footer', { pageScript: 'battle' }) %>
