<%- include('partials/layout-top', { activePage: 'dashboard' }) %>

<!-- STATS CARDS -->
<div class="stats-row">
  <div class="stat-card" style="--c:var(--accent)">
    <div class="stat-card-icon"><i class="fa-solid fa-bullseye"></i></div>
    <div class="stat-card-info">
      <div class="stat-card-num"><%= stats.totalQuizzes %></div>
      <div class="stat-card-label">اختبار</div>
    </div>
  </div>
  <div class="stat-card" style="--c:var(--accent-2)">
    <div class="stat-card-icon"><i class="fa-solid fa-book-open"></i></div>
    <div class="stat-card-info">
      <div class="stat-card-num"><%= stats.totalReviews %></div>
      <div class="stat-card-label">مراجعة</div>
    </div>
  </div>
  <div class="stat-card" style="--c:var(--accent-3)">
    <div class="stat-card-icon"><i class="fa-solid fa-circle-question"></i></div>
    <div class="stat-card-info">
      <div class="stat-card-num"><%= stats.totalQuestions %></div>
      <div class="stat-card-label">سؤال اختبار</div>
    </div>
  </div>
  <div class="stat-card" style="--c:var(--accent-4)">
    <div class="stat-card-icon"><i class="fa-solid fa-pen-fancy"></i></div>
    <div class="stat-card-info">
      <div class="stat-card-num"><%= stats.totalEssays %></div>
      <div class="stat-card-label">سؤال مقالي</div>
    </div>
  </div>
</div>

<!-- QUICK ACTIONS -->
<div class="section-card">
  <div class="section-card-header">
    <h2><i class="fa-solid fa-bolt" style="color: var(--accent); margin-left: 0.5rem;"></i> إجراءات سريعة</h2>
  </div>
  <div class="quick-actions">
    <a href="/admin/quizzes/new" class="quick-action-btn qa-green" title="إنشاء وتصميم اختبار تفاعلي جديد صح/خطأ أو اختيار من متعدد">
      <span class="qa-icon"><i class="fa-solid fa-plus"></i></span>
      <div>
        <div class="qa-title">اختبار جديد</div>
        <div class="qa-sub">أضف اختبار صح/خطأ أو اختيار متعدد</div>
      </div>
    </a>
    <a href="/admin/reviews/new" class="quick-action-btn qa-purple" title="إنشاء مادة مراجعة وتلخيصات وأسئلة مقالية جديدة">
      <span class="qa-icon"><i class="fa-solid fa-book-medical"></i></span>
      <div>
        <div class="qa-title">مراجعة جديدة</div>
        <div class="qa-sub">أضف موضوع مراجعة مع أسئلة مقالية</div>
      </div>
    </a>
    <a href="/" target="_blank" class="quick-action-btn qa-blue" title="عرض الصفحة الرئيسية والواجهة الأمامية للموقع">
      <span class="qa-icon"><i class="fa-solid fa-globe"></i></span>
      <div>
        <div class="qa-title">عرض الموقع</div>
        <div class="qa-sub">افتح الموقع في نافذة جديدة</div>
      </div>
    </a>
    <a href="/admin/settings" class="quick-action-btn qa-gray" title="تغيير وإعداد كلمة مرور حساب المشرف">
      <span class="qa-icon"><i class="fa-solid fa-sliders"></i></span>
      <div>
        <div class="qa-title">الإعدادات</div>
        <div class="qa-sub">تغيير كلمة المرور وإعدادات الحساب</div>
      </div>
    </a>
  </div>
</div>

<!-- TEACHER SUPPORT GUIDE -->
<div class="section-card">
  <div class="section-card-header" style="background: linear-gradient(135deg, rgba(167,139,250,0.05) 0%, rgba(0,212,170,0.05) 100%)">
    <h2><i class="fa-solid fa-circle-info" style="color: var(--accent-3); margin-left: 0.5rem;"></i> دليل المعلم الذكي والسرعة الفائقة ⚡</h2>
  </div>
  <div class="teacher-guide-grid">
    <div class="guide-item">
      <div class="guide-header"><i class="fa-solid fa-table" style="color: #38bdf8"></i> صناعة جداول مقارنة في ثوانٍ</div>
      <p class="guide-text">
        عند إنشاء أو تعديل <strong>المراجعات</strong>، يمكنك اختيار إضافة <strong>جدول مقارنة</strong>.
        اكتب رؤوس الأعمدة والصفوف بفصل الخلايا برمز الفاصل الرأسي <code>|</code>.
      </p>
      <div class="guide-code">
        وجه المقارنة | النباتية | الحيوانية
        <br>
        الجدار الخلوي | يوجد | لا يوجد
      </div>
    </div>
    
    <div class="guide-item">
      <div class="guide-header"><i class="fa-solid fa-square-root-variable" style="color: var(--accent-3)"></i> صياغة المسائل الرياضية</div>
      <p class="guide-text">
        اختر نوع <strong>مسألة رياضية</strong> لكتابة القوانين والمعادلات الحسابية. سيتلقى الطالب صندوقاً لكتابة خطوات الحل يدوياً قبل مقارنته بنموذج الإجابة الكامل.
      </p>
    </div>
    
    <div class="guide-item">
      <div class="guide-header"><i class="fa-solid fa-file-csv" style="color: #fbbf24"></i> استيراد CSV لسرعة 10x</div>
      <p class="guide-text">
        لا تضيع وقتك في إدخال الأسئلة واحداً تلو الآخر! في شاشة تعديل الاختبار، اضغط على زر <strong>استيراد الأسئلة (CSV)</strong>، حمّل القالب، واملأه بأسئلتك ثم ارفعه دفعة واحدة.
      </p>
    </div>
  </div>
</div>

<!-- TWO COLUMN: Quizzes + Reviews latest -->
<div class="two-col">
  <div class="section-card">
    <div class="section-card-header">
      <h2><i class="fa-solid fa-bullseye" style="color: var(--accent); margin-left: 0.5rem;"></i> آخر الاختبارات</h2>
      <a href="/admin/quizzes" class="btn-sm" title="عرض وإدارة كل الاختبارات التعليمية المتاحة">عرض الكل</a>
    </div>
    <% if (quizzes.length === 0) { %>
    <div class="empty-state-sm">لا توجد اختبارات بعد</div>
    <% } else { %>
    <div class="mini-list">
      <% quizzes.slice(-5).reverse().forEach(quiz => { %>
      <div class="mini-item">
        <span class="mini-icon"><i class="fa-solid fa-list-check" style="color: <%= quiz.color %>;"></i></span>
        <div class="mini-info">
          <div class="mini-title"><%= quiz.title %></div>
          <div class="mini-meta"><%= quiz.questions.length %> سؤال</div>
        </div>
        <div class="mini-actions">
          <a href="/admin/quizzes/<%= quiz.id %>/edit" class="icon-btn" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
          <a href="/quiz/<%= quiz.id %>" target="_blank" class="icon-btn" title="عرض"><i class="fa-solid fa-eye"></i></a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div class="section-card">
    <div class="section-card-header">
      <h2><i class="fa-solid fa-book-open" style="color: var(--accent-3); margin-left: 0.5rem;"></i> آخر المراجعات</h2>
      <a href="/admin/reviews" class="btn-sm" title="عرض وإدارة كل المراجعات والتلاخيص المتاحة">عرض الكل</a>
    </div>
    <% if (reviews.length === 0) { %>
    <div class="empty-state-sm">لا توجد مراجعات بعد</div>
    <% } else { %>
    <div class="mini-list">
      <% reviews.slice(-5).reverse().forEach(review => { %>
      <div class="mini-item">
        <span class="mini-icon"><i class="fa-solid fa-graduation-cap" style="color: <%= review.color %>;"></i></span>
        <div class="mini-info">
          <div class="mini-title"><%= review.title %></div>
          <div class="mini-meta"><%= review.subject %> · <%= review.sections.length %> أقسام</div>
        </div>
        <div class="mini-actions">
          <a href="/admin/reviews/<%= review.id %>/edit" class="icon-btn" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
          <a href="/review/<%= review.id %>" target="_blank" class="icon-btn" title="عرض"><i class="fa-solid fa-eye"></i></a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/layout-bottom') %>
