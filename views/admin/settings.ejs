<%- include('partials/layout-top', { activePage: 'settings' }) %>

<div class="page-actions-bar">
  <h2 class="page-bar-title">⚙️ الإعدادات</h2>
</div>

<div class="section-card" style="max-width:520px">
  <div class="section-card-header"><h3>🔐 تغيير كلمة المرور</h3></div>

  <% if (error) { %>
  <div class="alert alert-error" style="margin-bottom:1.25rem"><span>⚠️</span> <%= error %></div>
  <% } %>
  <% if (success) { %>
  <div class="alert alert-success" style="margin-bottom:1.25rem"><span>✅</span> <%= success %></div>
  <% } %>

  <form action="/admin/settings/password" method="POST">
    <div class="form-group">
      <label class="form-label">كلمة المرور الحالية</label>
      <input type="password" name="current" class="form-input" required placeholder="••••••••">
    </div>
    <div class="form-group">
      <label class="form-label">كلمة المرور الجديدة</label>
      <input type="password" name="newPass" class="form-input" required placeholder="6 أحرف على الأقل" minlength="6">
    </div>
    <div class="form-group">
      <label class="form-label">تأكيد كلمة المرور</label>
      <input type="password" name="confirm" class="form-input" required placeholder="أعد كتابة كلمة المرور">
    </div>
    <button type="submit" class="btn btn-primary save-btn">💾 حفظ التغييرات</button>
  </form>
</div>

<div class="section-card" style="max-width:520px;margin-top:1.5rem">
  <div class="section-card-header"><h3>ℹ️ معلومات النظام</h3></div>
  <div class="info-list">
    <div class="info-row">
      <span class="info-label">الإصدار</span>
      <span class="info-val">1.0.0</span>
    </div>
    <div class="info-row">
      <span class="info-label">محرك القواعد</span>
      <span class="info-val">JSON File DB</span>
    </div>
    <div class="info-row">
      <span class="info-label">إطار العمل</span>
      <span class="info-val">Express.js + EJS</span>
    </div>
  </div>
</div>

<%- include('partials/layout-bottom') %>
