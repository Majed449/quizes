<%- include('partials/layout-top', { activePage: 'quizzes' }) %>

<div class="page-actions-bar">
  <h2 class="page-bar-title"><%- mode === 'create' ? '<i class="fa-solid fa-circle-plus" style="color: var(--accent); margin-left: 0.5rem;"></i> اختبار جديد' : '<i class="fa-solid fa-pen-to-square" style="color: var(--accent); margin-left: 0.5rem;"></i> تعديل الاختبار' %></h2>
  <a href="/admin/quizzes" class="btn-sm" style="display: flex; align-items: center; gap: 0.4rem;"><i class="fa-solid fa-arrow-right"></i> العودة</a>
</div>

<form id="quizForm" action="<%= mode === 'create' ? '/admin/quizzes' : '/admin/quizzes/' + quiz.id %>" method="POST">
  <!-- Quiz Meta -->
  <div class="section-card">
    <div class="section-card-header"><h3><i class="fa-solid fa-circle-info" style="color: var(--accent); margin-left: 0.5rem;"></i> معلومات الاختبار</h3></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">عنوان الاختبار *</label>
        <input type="text" name="title" class="form-input" required
               value="<%= quiz ? quiz.title : '' %>" placeholder="مثال: اختبار العلوم العامة" title="أدخل عنوان الاختبار التعليمي (مثال: البنية التحتية للحوسبة)">
      </div>
      <div class="form-group">
        <label class="form-label">الوصف</label>
        <input type="text" name="description" class="form-input"
               value="<%= quiz ? quiz.description : '' %>" placeholder="وصف مختصر للاختبار" title="أدخل وصفاً مبسطاً لمساعدة الطالب على فهم محتوى وموضوع الاختبار">
      </div>
      <!-- Hidden icon input as user doesn't need to specify it manually -->
      <input type="hidden" name="icon" value="<%= quiz ? quiz.icon : '📝' %>">
      
      <div class="form-group">
        <label class="form-label">اللون المميز</label>
        <div class="color-input-wrap">
          <input type="color" name="color" id="colorPicker" class="color-picker"
                 value="<%= quiz ? quiz.color : '#38bdf8' %>" title="اختر لوناً مميزاً لبطاقة وجوانب هذا الاختبار">
          <input type="text" id="colorText" class="form-input" style="flex:1"
                 value="<%= quiz ? quiz.color : '#38bdf8' %>" placeholder="#38bdf8" title="يمكنك كتابة رمز اللون بالنظام الست عشري Hex (مثال: #38bdf8)">
        </div>
      </div>
    </div>
  </div>

  <!-- Questions Builder -->
  <div class="section-card">
    <div class="section-card-header" style="flex-wrap: wrap; gap: 1rem;">
      <h3><i class="fa-solid fa-list-check" style="color: var(--accent); margin-left: 0.5rem;"></i> الأسئلة (<span id="qCount">0</span>)</h3>
      <div style="display:flex;gap:0.6rem;flex-wrap:wrap">
        <button type="button" class="btn-sm btn-green" onclick="addQuestion('truefalse')" title="إضافة سؤال صح أو خطأ جديد للاختبار (Alt+T)"><i class="fa-solid fa-circle-plus" style="margin-left: 0.3rem;"></i> صح/خطأ</button>
        <button type="button" class="btn-sm btn-red" onclick="addQuestion('multiple')" title="إضافة سؤال اختيار من متعدد جديد للاختبار (Alt+M)"><i class="fa-solid fa-circle-plus" style="margin-left: 0.3rem;"></i> اختيار متعدد</button>
        <button type="button" class="btn-sm btn-blue" onclick="openTemplateModal()" title="تحميل أسئلة جاهزة من قوالب النظام"><i class="fa-solid fa-cubes" style="margin-left: 0.3rem;"></i> قوالب</button>
      </div>
    </div>

    <div id="questionsBuilder" class="questions-builder">
      <div class="questions-empty" id="emptyMsg">
        <i class="fa-solid fa-clipboard-question" style="font-size: 2rem; display: block; margin-bottom: 0.75rem; color: var(--text-dim);"></i>
        لم تضف أي أسئلة بعد — اضغط على أحد الأزرار أعلاه للبدء
      </div>
    </div>
  </div>

  <!-- Hidden input for questions JSON -->
  <input type="hidden" name="questions" id="questionsInput">

  <div class="form-actions">
    <a href="/admin/quizzes" class="btn btn-outline" title="إلغاء الإجراء والعودة إلى قائمة الاختبارات"><i class="fa-solid fa-xmark" style="margin-left: 0.3rem;"></i> إلغاء</a>
    <button type="submit" class="btn btn-primary" onclick="return prepareSubmit()" title="حفظ جميع التعديلات والأسئلة الحالية (Ctrl+S)">
      <span id="submitBtnLabel">
        <%- mode === 'create' ? '<i class="fa-solid fa-circle-plus" style="margin-left: 0.4rem;"></i> إنشاء الاختبار' : '<i class="fa-solid fa-floppy-disk" style="margin-left: 0.4rem;"></i> حفظ التعديلات' %>
      </span>
    </button>
  </div>
</form>

<!-- TEMPLATES MODAL -->
<div id="templateModal" class="modal" style="display:none">
  <div class="modal-content">
    <div class="modal-header">
      <h3>📋 قوالب الأسئلة</h3>
      <button class="modal-close" onclick="closeTemplateModal()">✕</button>
    </div>
    <div class="modal-body">
      <div id="templatesContainer" class="templates-grid">
        <div class="loading">جاري التحميل...</div>
      </div>
    </div>
  </div>
</div>

<style>
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  max-width: 500px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid var(--border);
}

.modal-header h3 {
  margin: 0;
  color: var(--text);
}

.modal-close {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 1.5rem;
  cursor: pointer;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  transition: all 0.2s;
}

.modal-close:hover {
  background: color-mix(in srgb, var(--accent-2) 10%, transparent);
  color: var(--accent-2);
}

.modal-body {
  padding: 1.5rem;
}

.modal-footer {
  display: flex;
  gap: 0.75rem;
  padding: 1.5rem;
  border-top: 1px solid var(--border);
  justify-content: flex-end;
}

.templates-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.template-card {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1rem;
  text-align: center;
  transition: all 0.2s;
}

.template-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--accent);
}

.template-name {
  font-weight: 600;
  color: var(--text);
  margin-bottom: 0.5rem;
  font-size: 0.95rem;
}

.template-type {
  color: var(--text-muted);
  font-size: 0.85rem;
  margin-bottom: 0.75rem;
}

.template-card button {
  width: 100%;
  padding: 0.5rem;
  background: var(--accent);
  color: var(--btn-text-color);
  border: none;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.9rem;
}

.template-card button:hover {
  filter: brightness(1.1);
}

.save-indicator {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  background: var(--accent);
  color: var(--btn-text-color);
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  font-weight: 600;
  box-shadow: var(--shadow-accent);
  animation: slideUp 0.3s ease-out;
  z-index: 999;
}

@keyframes slideUp {
  from {
    transform: translateY(100px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
</style>

<script>
const INITIAL_QUIZ = <%- JSON.stringify(quiz) %>;
</script>
<%- include('partials/layout-bottom', { pageScript: 'admin-quiz-form' }) %>
